{
  "name": "@fis/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:build": "zensical build",
    "dev": "pnpm --filter @fis/worker dev",
    "deploy": "pnpm --filter @fis/worker run deploy",
    "console:dev": "pnpm --filter @fis/console dev",
    "console:build": "pnpm --filter @fis/console build",
    "mcp:dev": "pnpm --filter @fis/mcp dev",
    "mcp:deploy": "pnpm --filter @fis/mcp run deploy",
    "mcp:oauth:smoke": "pnpm --filter @fis/mcp oauth:smoke",
    "mcp:smoke": "pnpm --filter @fis/mcp smoke",
    "skills:validate": "node scripts/validate-skills.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "cellar-door:spine-size": "node scripts/cellar-door-spine-expansion.mjs",
    "cellar-door:reference-integrity": "node scripts/cellar-door-reference-integrity-check.mjs",
    "test": "pnpm skills:validate && pnpm migrations:validate && pnpm --filter @fis/worker test && pnpm --filter @fis/mcp test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:migrate:local": "pnpm --filter @fis/worker db:migrate:local",
    "db:migrate:prod": "pnpm --filter @fis/worker db:migrate:prod",
    "prepare": "husky",
    "lint": "eslint .",
    "test:unit:fast": "vitest run --config vitest.unit.config.ts",
    "precommit": "pnpm typecheck && pnpm exec lint-staged && pnpm test:unit:fast"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": "eslint --no-warn-ignored --max-warnings=0"
  }
}
